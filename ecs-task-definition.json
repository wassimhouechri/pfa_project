{
  "family": "devsecops-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::792782834628:role/LabRole",
  "taskRoleArn": "arn:aws:iam::792782834628:role/LabRole",
  "containerDefinitions": [
    {
      "name": "devsecops-app",
      "image": "DOCKERHUB_IMAGE_PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "FLASK_ENV",        "value": "production"        },
        { "name": "PORT",             "value": "5000"              },
        { "name": "PYTHONUNBUFFERED", "value": "1"                 },
        { "name": "AWS_REGION",       "value": "us-east-1"         },
        { "name": "ECS_CLUSTER",      "value": "devsecops-cluster" },
        { "name": "ECS_SERVICE",      "value": "devsecops-service" },
        { "name": "CW_LOG_GROUP",     "value": "/ecs/devsecops"    },
        { "name": "SNS_TOPIC_ARN",    "value": "arn:aws:sns:us-east-1:792782834628:soc-alerts" }
      ],
      "secrets": [
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:792782834628:parameter/devsecops/secret-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/devsecops",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command":     ["CMD-SHELL", "curl -f http://localhost:5000/health || exit 1"],
        "interval":    30,
        "timeout":     5,
        "retries":     3,
        "startPeriod": 60
      }
    }
  ]
}